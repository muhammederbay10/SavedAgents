# Copy this file to `.env` and adjust the values. `.env` is git-ignored.
# All values below are dummy values for local development. Never commit real secrets.

# --- API settings (read by app/config.py) ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Used when the API runs on your machine (`make run`). Under Docker Compose the
# API gets its own DATABASE_URL and REDIS_URL that point at the `db` and `redis`
# services, built from the POSTGRES_* values below.
DATABASE_URL=postgresql+asyncpg://savedagent:change-me@localhost:5432/savedagent
REDIS_URL=redis://localhost:6379/0
# Length of the embedding vectors, 1 to 2000. It must match the embedding model.
# 1024 is the size chosen for openai/text-embedding-3-large (SAV-7).
# The first migration creates the embedding columns with this size. Changing it
# afterwards needs a new migration and embedding everything again.
EMBEDDING_DIMENSION=1024

# --- Instagram webhook (read by app/config.py) ---
# The Meta app's secret (App settings → Basic). Meta signs every webhook with it.
META_APP_SECRET=change-me
# Any long random text. Enter the same value as "Verify token" in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=change-me
# A text sent this many seconds or less after a share is stored as that item's
# collection hint instead of being answered as a question. 9 seconds was the gap
# in the recorded webhooks (decision record 0002).
COLLECTION_HINT_WINDOW_SECONDS=30
# How long ingestion keeps a user's job payloads, text receipts and recent shares
# in Redis. Meta delivers a failed webhook again for up to 36 hours (Graph API
# webhooks documentation), so 36 hours = 129600 seconds. At least the hint window.
INGESTION_STATE_TTL_SECONDS=129600

# --- Docker Compose: Postgres container ---
POSTGRES_USER=savedagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=savedagent

# --- Docker Compose: ports published on 127.0.0.1 ---
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Model clients (read by app/config.py, ModelSettings; see README "Models") ---
# Every model call goes through OpenRouter with this one key. Never commit a real key.
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The decisions endpoint has its own URL. It is not chat completions.
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# A call that fails with a timeout, a rate limit or a server error is tried this
# many times in total. The wait starts at the base delay, doubles each time and
# never passes the maximum.
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_DELAY_SECONDS=0.5
OPENROUTER_RETRY_MAX_DELAY_SECONDS=8

# Fixed decisions (type, tags, is-list, which candidate, …).
DECISION_MODEL=google/gemini-decision-1
DECISION_TIMEOUT_SECONDS=30

# Extraction and the response agent.
TEXT_MODEL=deepseek/deepseek-v4.1-flash
# The ONE provider endpoint that may serve the text model. It must be hosted
# outside China (DeepSeek's own API is not). Requests are never sent to another
# provider: if this one cannot serve a call, the call fails.
# TEXT_MODEL_PROVIDER is the endpoint's OpenRouter slug. TEXT_MODEL_PROVIDER_NAME
# is the name OpenRouter reports for it in a reply's routing metadata; a reply
# not proven to come from it is discarded. This choice is a proposal awaiting the
# owner's decision; its evidence is in decision record 0010.
TEXT_MODEL_PROVIDER=coreweave/fp8
TEXT_MODEL_PROVIDER_NAME=CoreWeave
TEXT_TIMEOUT_SECONDS=30

# The video model for the rare escalation (silent reels with text overlays).
ESCALATION_MODEL=google/gemini-2.5-flash
ESCALATION_TIMEOUT_SECONDS=60

# Speech-to-text. The fallback model is asked when the default model fails or
# returns no words. The response format is `verbose_json` (language and
# timestamps) or `json` (text only); openai/gpt-transcribe rejects verbose_json.
TRANSCRIPTION_MODEL=microsoft/mai-transcribe-2
TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
TRANSCRIPTION_FALLBACK_MODEL=openai/gpt-transcribe
TRANSCRIPTION_FALLBACK_RESPONSE_FORMAT=json
TRANSCRIPTION_TIMEOUT_SECONDS=60

# Embeddings. The vector size is EMBEDDING_DIMENSION above.
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_TIMEOUT_SECONDS=30

# --- Instagram Send API: the bot's DM replies (read by app/config.py, MessengerSettings) ---
# Base URL of the Graph API with its version. Messages go to <URL>/<INSTAGRAM_ACCOUNT_ID>/messages.
# graph.facebook.com is the host record 0004 tested with the bot's token. A token from
# "Instagram API with Instagram Login" uses https://graph.instagram.com/<version> instead.
INSTAGRAM_GRAPH_API_URL=https://graph.facebook.com/v27.0
# The bot's Instagram professional account id (the {ig-user-id} of the Send API).
INSTAGRAM_ACCOUNT_ID=17840000000000001
# The bot's access token (Meta app → Instagram → Generate access tokens). Never commit a real one.
INSTAGRAM_ACCESS_TOKEN=change-me
# Instagram accepts replies only this long after the user's last message. Older ones are skipped.
INSTAGRAM_REPLY_WINDOW_HOURS=24
SEND_API_TIMEOUT_SECONDS=10
# A message Meta rate-limits or can't take (no connection, HTTP 503) is tried this many
# times in total. The wait starts at the base delay, doubles each time and never passes the
# maximum, also when Meta asks for longer. A timeout after the request went out is never
# retried, so a user never gets the same DM twice.
SEND_API_MAX_ATTEMPTS=3
SEND_API_RETRY_BASE_DELAY_SECONDS=1
SEND_API_RETRY_MAX_DELAY_SECONDS=8
